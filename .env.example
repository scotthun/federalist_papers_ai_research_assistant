# Repo-root fallback env file for local development. apps/api looks here
# only if apps/api/.env (see apps/api/.env.example) doesn't exist. Matches
# the default credentials in docker-compose.yml.
DATABASE_URL=postgres://federalist:federalist@localhost:5432/federalist_research

# apps/api's HTTP port (Story 1.3). Moved off 3000 -- identical to Next.js's own dev-server
# default, and apps/web + apps/api now run concurrently for real cross-app HTTP calls.
PORT=3333

# See apps/api/.env.example for what this does.
WEB_ORIGIN=

# See apps/api/.env.example for what these do.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
INGEST_FETCH_DELAY_MS=500
INGEST_EMBED_DELAY_MS=250
INGEST_FIRST_PAPER=1
INGEST_LAST_PAPER=85
INGEST_CHUNK_TARGET_WORDS=750
INGEST_CHUNK_MAX_WORDS=1000
INGEST_CHUNK_OVERLAP_WORDS=100

# See apps/api/.env.example for what these do (Story 4.2 rate limiting, via Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ASK_RATE_LIMIT_PER_MINUTE=10
ASK_DAILY_LIMIT=250
