# Repo-root fallback env file for local development. apps/api looks here
# only if apps/api/.env (see apps/api/.env.example) doesn't exist. Matches
# the default credentials in docker-compose.yml.
DATABASE_URL=postgres://federalist:federalist@localhost:5432/federalist_research

# See apps/api/.env.example for what these do.
AI_PROVIDER=gemini
GEMINI_API_KEY=
INGEST_FETCH_DELAY_MS=500
INGEST_EMBED_DELAY_MS=250
INGEST_FIRST_PAPER=1
INGEST_LAST_PAPER=85
INGEST_CHUNK_TARGET_WORDS=750
INGEST_CHUNK_MAX_WORDS=1000
INGEST_CHUNK_OVERLAP_WORDS=100
