{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "build-migrate": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build --config webpack.migrate.config.js",
        "cwd": "apps/api"
      }
    },
    "migrate": {
      "dependsOn": ["build-migrate"],
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/api-migrate/main.js"
      }
    },
    "build-ingest": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build --config webpack.ingest.config.js",
        "cwd": "apps/api"
      }
    },
    "ingest": {
      "dependsOn": ["build-ingest"],
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node --use-system-ca dist/apps/api-ingest/main.js"
      }
    },
    "build-eval-retrieval": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build --config webpack.eval-retrieval.config.js",
        "cwd": "apps/api"
      }
    },
    "eval-retrieval": {
      "dependsOn": ["build-eval-retrieval"],
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/api-eval-retrieval/main.js"
      }
    },
    "build-calibrate-thresholds": {
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build --config webpack.calibrate-thresholds.config.js",
        "cwd": "apps/api"
      }
    },
    "calibrate-thresholds": {
      "dependsOn": ["build-calibrate-thresholds"],
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node dist/apps/api-calibrate-thresholds/main.js"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
