# Copy this file to apps/api/.env for local development (checked first) —
# or to a repo-root .env (checked as a fallback if apps/api/.env doesn't
# exist; see the root .env.example). Matches the default credentials in
# docker-compose.yml.
DATABASE_URL=postgres://federalist:federalist@localhost:5432/federalist_research

# HTTP port apps/api listens on (Story 1.3). Moved off 3000 -- identical to Next.js's own
# dev-server default, and apps/web + apps/api now run concurrently for real cross-app HTTP
# calls. apps/web reads this same value via its own API_BASE_URL (see apps/web/.env.example).
PORT=3333

# AI provider abstraction (libs/ai) -- selects which concrete *generation* adapter
# ai-provider.factory.ts's createGenerationProvider() constructs ("gemini", "openrouter", or "groq").
# Embeddings always use Gemini regardless of this value (GEMINI_API_KEY is required
# unconditionally, below) -- pgvector's stored embedding column is pinned to
# gemini-embedding-001's output, a deliberate, separately-costed migration to change.
AI_PROVIDER=gemini
# Required unconditionally -- embeddings always use Gemini regardless of AI_PROVIDER (see above).
# Also required when AI_PROVIDER=gemini, since GeminiProvider is then the generation adapter too.
# Get a key from https://aistudio.google.com/apikey -- never commit a real value here.
GEMINI_API_KEY=
# Optional override for GeminiProvider's generation model (default: gemini-3.6-flash) -- e.g. a
# specific model returning live 503 "high demand" responses can be worked around by restarting
# with a different value here, without editing source. Never affects the embedding model
# (gemini-embedding-001 is pinned separately -- libs/database's vector column dimension depends
# on it).
GEMINI_GENERATION_MODEL=

# Required when AI_PROVIDER=openrouter. Get a key from https://openrouter.ai/keys -- never commit
# a real value here. OpenRouter's free tier is account-level (20 requests/minute flat; a daily cap
# of 50 requests/day by default, rising to 1000/day once the account has purchased $10+ in
# lifetime credits), not per-model.
OPENROUTER_API_KEY=
# Optional override for OpenRouterProvider's generation model (default:
# nvidia/nemotron-3-super-120b-a12b:free -- OpenRouter's only free Nemotron model exposing both
# native structured_outputs/response_format and tools/tool_choice as of this story's 2026-09-05
# research). OpenRouter's free-model catalog and rate-limit tiers can change, so a model becoming
# unavailable/unlisted can be worked around by restarting with a different value here, without
# editing source. Never affects the embedding model (embeddings always use Gemini, see above).
OPENROUTER_MODEL=

# Required when AI_PROVIDER=groq. Get a key from https://console.groq.com/keys -- never commit a
# real value here. Groq's free tier is fast (300-800 tokens/sec, LPU hardware) -- this provider
# exists as a quick MANUAL fallback (flip this env var and restart) for when Gemini's free tier
# hits its repeated 503 "high demand" outages, since OpenRouter's free Nemotron tier proved too
# slow (140-400+ seconds/response) to switch to live. There is no automatic failover between
# providers -- AI_PROVIDER always selects exactly one, read once at startup.
# openai/gpt-oss-120b's free-tier limits: 30 requests/minute, 1,000 requests/day, 8,000
# tokens/minute, 200,000 tokens/day (per-model, unlike OpenRouter's account-level cap). Note the
# 8,000 tokens/minute figure is a throughput rate limit, not the model's context window (which is
# 131K tokens) -- but combined with this app's uncapped-by-default conversation history
# (spec-conversation-history-context.md), a single large prompt could still consume most or all of
# that per-minute budget in one call.
GROQ_API_KEY=
# Optional override for GroqProvider's generation model (default: openai/gpt-oss-120b -- the only
# free-tier model confirmed, against Groq's own structured-outputs doc, to support strict
# JSON-schema-conformant structured output; llama-3.3-70b-versatile and other Llama models are not
# confirmed strict-mode-capable). Groq's free-model catalog and rate-limit tiers can change, so a
# model becoming unavailable/unlisted can be worked around by restarting with a different value
# here, without editing source. Never affects the embedding model (embeddings always use Gemini,
# see above).
GROQ_MODEL=

# Modest delay (ms) between sequential Avalon page fetches during ingestion (Avalon's
# rate-limiting is untested/unguarded against) -- configurable, not hard-coded.
INGEST_FETCH_DELAY_MS=500
# Delay (ms) between sequential per-chunk embedding calls during ingestion -- observed live
# against the Gemini API's free-tier rate limit; raise this if a full 85-paper run still trips
# HTTP 429 RESOURCE_EXHAUSTED (each failure is logged and the run continues regardless).
INGEST_EMBED_DELAY_MS=250
# Override the paper-number range ingestion processes (both inclusive) -- default is the full
# corpus, 1-85. Useful for a smoke test or resuming a partial run without editing code.
INGEST_FIRST_PAPER=1
INGEST_LAST_PAPER=85

# Chunking (libs/documents/chunker.ts) -- configurable, not hard-coded (stack.md). Defaults
# below match DEFAULT_CHUNK_OPTIONS; words approximate tokens (see the spec's Design Notes).
INGEST_CHUNK_TARGET_WORDS=750
INGEST_CHUNK_MAX_WORDS=1000
INGEST_CHUNK_OVERLAP_WORDS=100
