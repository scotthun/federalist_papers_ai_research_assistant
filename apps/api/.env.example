# Copy this file to apps/api/.env for local development (checked first) —
# or to a repo-root .env (checked as a fallback if apps/api/.env doesn't
# exist; see the root .env.example). Matches the default credentials in
# docker-compose.yml.
DATABASE_URL=postgres://federalist:federalist@localhost:5432/federalist_research

# HTTP port apps/api listens on (Story 1.3). Moved off 3000 -- identical to Next.js's own
# dev-server default, and apps/web + apps/api now run concurrently for real cross-app HTTP
# calls. apps/web reads this same value via its own API_BASE_URL (see apps/web/.env.example).
PORT=3333

# AI provider abstraction (libs/ai) -- selects which concrete adapter
# ai-provider.factory.ts constructs. "gemini" is the only implemented provider today.
AI_PROVIDER=gemini
# Required when AI_PROVIDER=gemini. Get a key from https://aistudio.google.com/apikey -- never
# commit a real value here.
GEMINI_API_KEY=
# Optional override for GeminiProvider's generation model (default: gemini-3.6-flash) -- e.g. a
# specific model returning live 503 "high demand" responses can be worked around by restarting
# with a different value here, without editing source. Never affects the embedding model
# (gemini-embedding-001 is pinned separately -- libs/database's vector column dimension depends
# on it).
GEMINI_GENERATION_MODEL=

# Modest delay (ms) between sequential Avalon page fetches during ingestion (Avalon's
# rate-limiting is untested/unguarded against) -- configurable, not hard-coded.
INGEST_FETCH_DELAY_MS=500
# Delay (ms) between sequential per-chunk embedding calls during ingestion -- observed live
# against the Gemini API's free-tier rate limit; raise this if a full 85-paper run still trips
# HTTP 429 RESOURCE_EXHAUSTED (each failure is logged and the run continues regardless).
INGEST_EMBED_DELAY_MS=250
# Override the paper-number range ingestion processes (both inclusive) -- default is the full
# corpus, 1-85. Useful for a smoke test or resuming a partial run without editing code.
INGEST_FIRST_PAPER=1
INGEST_LAST_PAPER=85

# Chunking (libs/documents/chunker.ts) -- configurable, not hard-coded (stack.md). Defaults
# below match DEFAULT_CHUNK_OPTIONS; words approximate tokens (see the spec's Design Notes).
INGEST_CHUNK_TARGET_WORDS=750
INGEST_CHUNK_MAX_WORDS=1000
INGEST_CHUNK_OVERLAP_WORDS=100
