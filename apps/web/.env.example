# Copy this file to apps/web/.env for local development. Next.js loads it automatically.
#
# Base URL apps/web uses to reach apps/api over HTTP -- apps/web never accesses the database
# directly (Structural Seed); every read goes through apps/api's HTTP endpoints. Default below
# matches apps/api's own default port, 3333 (see apps/api/.env.example). Deliberately not
# NEXT_PUBLIC_-prefixed: it's only ever read server-side (in a Server Component that never runs
# in the browser), so it doesn't need client-bundle inlining.
API_BASE_URL=http://localhost:3333/api
