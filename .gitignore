# System files
.DS_Store
Thumbs.db

# throwaway Story 0.1 spike (never merged into main)
/spike

# AI tooling (local-only, not part of the shipped project)
.claude/
_bmad-output/

# _bmad/ is tool-vendored, except the team-shared override file BMAD itself
